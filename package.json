{
  "name": "amc-tracker",
  "version": "1.0.0",
  "main": "electron.js",
  "scripts": {
    "start": "electron .",
    "dev": "vite --host --port 3000",
    "build": "vite build",
    "prestart": "npm run build",
    "test": "jest",
    "dist": "vite build && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "description": "An offline application for logging and inputting data related to printers, PCs, and UPS Annual Maintenance Contract (AMC) services.",
  "dependencies": {
    "@tanstack/react-table": "^8.21.2",
    "date-fns": "^4.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sqlite": "^4.0.23",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "jest": "^29.7.0",
    "vite": "^5.2.8",
    "vite-plugin-electron": "^0.29.0"
  },
  "build": {
    "appId": "com.yourcompany.amctracker",
    "productName": "AMC Tracker",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**",
      "electron.js",
      "src/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "./public/logo.jpg"
    }
  }
}
